# ---------------------------------------------------------------------------
# Plantilla de variables de entorno. Copia este archivo a .env y rellena los
# valores reales. El archivo .env está en .gitignore y NUNCA debe subirse.
#
# Todo lo que empieza por VITE_ se incrusta en el bundle público de la web:
# solo pueden ir ahí claves publicables. Las claves secretas (service_role,
# Stripe secret, Resend) van en el panel del proveedor, jamás en el frontend.
# ---------------------------------------------------------------------------

# Frontend (valores públicos)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<clave-publicable-de-supabase>
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_<clave-publicable-de-stripe>

# Solo para scripts de administración ejecutados en local (seed, migraciones).
# Da acceso total saltándose RLS: trátala como una contraseña de root.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Secretos del backend: configúralos en el panel de Supabase / Stripe,
# no en este archivo, si el despliegue no los necesita en local.
# STRIPE_SECRET_KEY=sk_test_<clave-secreta-de-stripe>

# Variables de la Edge Function send-contact-email
# (Supabase > Edge Functions > Secrets)
# RESEND_API_KEY=
# RESEND_FROM=ManiPedi Web <notificaciones@manipedibellezaintegral.es>
# CONTACT_NOTIFICATION_EMAIL=manipedilasarenas18@gmail.com
# CONTACT_WEBHOOK_SECRET=<cadena-aleatoria-larga>   # mismo valor que app.contact_webhook_secret en la BD
# ALLOWED_ORIGINS=https://manipedilasarenas.com,https://www.manipedilasarenas.com

# Módulos no publicados. El panel de administración está sin terminar: sus
# rutas solo existen si esta variable vale exactamente "true" en la build.
# Déjala sin definir en producción.
# VITE_ENABLE_ADMIN=false
